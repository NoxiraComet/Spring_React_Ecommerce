#!/bin/bash
# Environment Variables Setup Script
# Run this locally: source .env.local (do not commit to git)
# For production, set these in your hosting provider or secret manager

# Database Credentials
export DB_HOST="localhost"
export DB_PORT="5432"
export DB_NAME="perfume"
export DB_USERNAME="postgres"
export DB_PASSWORD="your_secure_db_password_here"

# Email Configuration
export MAIL_HOST="smtp.gmail.com"
export MAIL_USERNAME="your-email@gmail.com"
export MAIL_PASSWORD="your_app_specific_password_here"
export MAIL_PORT="465"

# Google OAuth2
export GOOGLE_CLIENT_ID="your_google_client_id"
export GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Facebook OAuth2
export FACEBOOK_CLIENT_ID="your_facebook_client_id"
export FACEBOOK_CLIENT_SECRET="your_facebook_client_secret"

# GitHub OAuth2
export GITHUB_CLIENT_ID="your_github_client_id"
export GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google reCAPTCHA
export RECAPTCHA_SECRET="your_recaptcha_secret"

# AWS S3
export AWS_S3_BUCKET_NAME="your_s3_bucket_name"

# JWT Secret (CRITICAL: Generate a strong random value for production)
# You can generate with: openssl rand -base64 32
export JWT_SECRET="your_strong_random_jwt_secret_here"
export JWT_EXPIRATION="604800"

# Frontend Host
export FRONTEND_HOST="localhost:3000"
